#!/usr/bin/env python3
"""anki-status — read-only snapshot of the local Anki collection as JSON.

Reads the Anki collection DB through SQLite's immutable mode — no locks, so
Anki's own writes never stall us; the WAL tail (at most the review currently
on screen) is skipped, which is fine for a status widget. Prints the record
the Anki Status shell plugin consumes:

  {
    "running": bool,
    "profile": str,
    "collection": str,        # absolute path, may be ""
    "new": int, "learn": int, "review": int, "due": int,
    "studiedToday": int, "timeTodaySec": int,
    "todayLimit": int,        # deck-config new-card daily cap (min over groups with unreviewed new cards); 0 = unlimited
    "newRemaining": int,      # due new cards as the cap constrains them; equals "new" when uncapped
    "retention": float,       # 30-day mature (ivl>=21d) correct rate, 0-1; -1 when no data
    "forecast": [ { "day": "YYYY-MM-DD", "count": int } ],
    "decks": [ {              # heaviest decks first, at most --max-decks rows
      "name": str, "depth": int,
      "new": int, "learn": int, "review": int, "due": int, "newRemaining": int,
      "studiedToday": int, "timeTodaySec": int, "retention": float
    } ],
    "deckCount": int,         # deck rows before the row cap; -1 when unknown
                              #   (the deck table outran the scan budget)
    "decksTruncated": bool,   # true when rows were dropped to stay in budget
    "error": str              # present on failure
  }

Every field is bounded: the profile totals are whole-collection aggregates,
but the per-deck breakdown is capped in rows, name length, and total bytes,
and every query runs under a wall-clock deadline. A huge — or hostile —
collection can therefore never hand the shell an unbounded document to
buffer, nor keep it waiting indefinitely.

Usage: anki-status [--profile NAME] [--forecast-days N] [--collection PATH]
                   [--max-decks N]
"""

import argparse
import json
import os
import re
import sqlite3
import subprocess
import sys
import time
from pathlib import Path

ANKI_BASE = Path(os.environ.get("ANKI_BASE", Path.home() / ".local/share/Anki2"))

# Output budget. The panel buffers our stdout whole, so the report has to be
# bounded no matter what the collection looks like: at most MAX_DECK_ROWS
# rows, each displayed name clipped to MAX_DECK_NAME chars, the error string
# clipped to MAX_ERROR_CHARS, and a final byte ceiling that sheds rows — and
# failing that, falls back to a minimal record — if anything still overshoots.
DEFAULT_DECK_ROWS = 40
MAX_DECK_ROWS = 200
MAX_DECK_NAME = 80
# Characters are the wrong unit for the byte budget: json.dumps escapes
# non-ASCII, so one CJK character costs 6 bytes and one emoji 12. An 80-char
# name of emoji weighs most of a kilobyte, which is why displayed names are
# also held to a byte cost, not just a length.
MAX_DECK_NAME_BYTES = 240
MAX_ERROR_CHARS = 2000
# How much of a deck name is read out of the collection at all. Deck names
# are unbounded there, and the roster holds one per deck, so the read itself
# has to be clipped — well above MAX_DECK_NAME, since this one is the
# aggregation key and clipping it merges decks that merely share a prefix.
MAX_KEY_NAME = 512
MAX_OUTPUT_BYTES = 64 * 1024
# Deck rows read out of the collection at all. Profile totals are computed by
# whole-table aggregates and stay exact past this; only the per-deck
# breakdown truncates, flagged by "decksTruncated". Ordering by id is for
# determinism only — past this many decks, which ones we keep is arbitrary.
MAX_DECK_SCAN = 5000
# Wall clock a single snapshot may spend inside SQLite before we give up and
# report an error instead of stalling the panel's refresh.
QUERY_DEADLINE_SEC = 10.0


def anki_running() -> bool:
    try:
        out = subprocess.run(
            ["pgrep", "-f", r"(^|/)anki(\s|$)"],
            capture_output=True, text=True, timeout=5,
        )
        return bool(out.stdout.strip())
    except Exception:
        return False


def profiles() -> list[str]:
    try:
        return sorted(
            p.name for p in ANKI_BASE.iterdir()
            if p.is_dir() and (p / "collection.anki2").exists()
        )
    except OSError:
        return []


def pick_profile(requested: str | None) -> str | None:
    available = profiles()
    if not available:
        return None
    if requested:
        return requested if requested in available else None
    # Anki records the last-opened profile in prefs21.db; fall back to a lone
    # profile, else the first alphabetically.
    try:
        db = sqlite3.connect(f"file:{ANKI_BASE / 'prefs21.db'}?mode=ro", uri=True)
        row = db.execute("SELECT value FROM preferences WHERE key='profile'").fetchone()
        db.close()
        if row and row[0] in available:
            return row[0]
    except sqlite3.Error:
        pass
    return available[0]


def config_value(con, key: str, default=None):
    row = con.execute("SELECT val FROM config WHERE KEY=?", (key,)).fetchone()
    if not row:
        return default
    raw = row[0]
    try:
        return json.loads(raw)
    except (ValueError, TypeError):
        # Older builds store plain strings/ints without JSON quoting.
        try:
            return int(raw)
        except (ValueError, TypeError):
            return raw.decode() if isinstance(raw, bytes) else default


def day_boundary(con) -> tuple[float, int]:
    """Returns (today_start_unix_sec, today_number).

    today_number is Anki's day counter for review-card `due` values: days
    elapsed since collection creation at the rollover hour. Rollover is the
    local hour in the `rollover` config key (default 4am); `creationOffset`
    pins the collection's creation timezone as minutes-west-of-UTC so the
    anchor survives travel across timezones.
    """
    crt = con.execute("SELECT crt FROM col").fetchone()[0]
    rollover = config_value(con, "rollover", 4)
    offset_min = config_value(con, "creationOffset", None)
    if offset_min is None:
        offset_min = -time.localtime().tm_gmtoff // 60 if hasattr(time.localtime(), "tm_gmtoff") else -int(time.timezone // 60)
    if isinstance(offset_min, str):
        offset_min = int(offset_min)
    # Collection-local midnight: crt shifted into the creation tz.
    local_midnight = (crt - offset_min * 60) // 86400 * 86400
    anchor = local_midnight + offset_min * 60 + rollover * 3600
    now = time.time()
    elapsed = now - anchor
    day_number = int(elapsed // 86400)
    today_start = anchor + day_number * 86400
    return today_start, day_number


# --- deck_config protobuf ------------------------------------------------
#
# Since 23.10 the daily new-card cap lives in deck_config.config, a protobuf
# (anki/deck_config.proto DeckConfig). We need exactly one field:
# new.per_day — inside the DailyLimits message (field 1), inner field 1.
# A tiny hand-rolled wire parser avoids a protobuf dependency in the plugin.

def read_varint(buf: bytes, i: int) -> tuple[int, int]:
    shift = 0
    result = 0
    while True:
        if i >= len(buf):
            raise IndexError("truncated varint")
        b = buf[i]
        i += 1
        result |= (b & 0x7F) << shift
        if not (b & 0x80):
            return result, i
        shift += 7
        if shift > 63:
            raise ValueError("varint too long")


def iter_fields(buf: bytes):
    i = 0
    while i < len(buf):
        key, i = read_varint(buf, i)
        field, wire = key >> 3, key & 7
        if field == 0:
            return
        if wire == 0:
            val, i = read_varint(buf, i)
            yield field, wire, val
        elif wire == 2:
            n, i = read_varint(buf, i)
            if i + n > len(buf):
                return
            yield field, wire, buf[i:i + n]
            i += n
        elif wire == 5:
            if i + 4 > len(buf):
                return
            yield field, wire, buf[i:i + 4]
            i += 4
        elif wire == 1:
            if i + 8 > len(buf):
                return
            yield field, wire, buf[i:i + 8]
            i += 8
        else:
            return


def deck_config_new_per_day(blob: bytes) -> int:
    """DeckConfig.other.new_per_day — 0 means unlimited.

    Schema (anki/deck_config.proto): field 1 is `other` (DailyLimits-ish
    legacy block in current builds); within it, field 1 is the new-card
    daily cap. We scan every length-delimited submessage for a plausible
    (1, varint) pair and prefer the one under top-level field 1.
    """
    try:
        for field, wire, val in iter_fields(blob):
            if field == 1 and wire == 2:
                try:
                    for f2, w2, v2 in iter_fields(val):
                        if f2 == 1 and w2 == 0:
                            return int(v2)
                except Exception:
                    continue
    except Exception:
        pass
    return 0


def build_report(collection: Path, forecast_days: int, max_decks: int) -> dict:
    # Immutable mode: SQLite opens the file without taking locks, reading the
    # last committed main-file state. The WAL tail (at most the currently open
    # review) is skipped, which is fine for a status widget and keeps us from
    # ever stalling behind Anki's own writes — a plain read or a backup-API
    # copy can block indefinitely on Anki's write lock.
    con = sqlite3.connect(f"file:{collection}?immutable=1", uri=True)
    try:
        # A corrupt or adversarial DB can make an otherwise cheap aggregate
        # run arbitrarily long. The progress handler aborts the statement
        # once the snapshot has overrun its deadline, and SQLite surfaces
        # that as an OperationalError main() turns into `error`.
        deadline = time.monotonic() + QUERY_DEADLINE_SEC
        con.set_progress_handler(lambda: 1 if time.monotonic() > deadline else 0, 20000)
        return query_report(con, forecast_days, max_decks)
    finally:
        con.set_progress_handler(None, 0)
        con.close()


def query_report(con: sqlite3.Connection, forecast_days: int, max_decks: int) -> dict:
    today_start_sec, today_number = day_boundary(con)
    today_start_ms = int(today_start_sec * 1000)
    day_len = 86400
    day_cutoff_end = today_number + 1  # review due value that still counts as today

    # --- today's queues ---------------------------------------------------
    # Cards with odid set are buried/filtered-deck residents: excluded from
    # today's queues the same way Anki's own counts exclude them.
    new_today = con.execute(
        "SELECT count(*) FROM cards WHERE queue=0 AND type=0 AND odid=0"
    ).fetchone()[0]
    learn_today = con.execute(
        "SELECT count(*) FROM cards WHERE queue IN (1,3) AND odid=0 AND due <= ?",
        (int(today_start_sec + day_len),),
    ).fetchone()[0]
    review_today = con.execute(
        "SELECT count(*) FROM cards WHERE queue=2 AND odid=0 AND due <= ?",
        (day_cutoff_end,),
    ).fetchone()[0]

    # --- studied today ----------------------------------------------------
    studied = con.execute(
        "SELECT count(*), coalesce(sum(time)/1000, 0) FROM revlog WHERE id >= ?",
        (today_start_ms,),
    ).fetchone()
    studied_today, time_today_sec = int(studied[0]), int(studied[1] or 0)

    # --- deck config: new-card daily caps ---------------------------------
    # decks.common is a protobuf carrying the deck's config id (field 5);
    # deck_config rows hold the preset blob with the per-day new cap.
    conf_caps = {}
    for conf_id, blob in con.execute("SELECT id, config FROM deck_config LIMIT ?", (MAX_DECK_SCAN,)):
        conf_caps[int(conf_id)] = deck_config_new_per_day(blob)

    def deck_conf_id(common: bytes) -> int:
        try:
            for field, wire, val in iter_fields(common):
                if field == 5 and wire == 0:
                    return int(val)
        except Exception:
            pass
        return 1

    # --- deck roster ------------------------------------------------------
    # Read once, capped: everything per-deck below keys off this dict, so a
    # collection with a pathological number of decks costs us MAX_DECK_SCAN
    # rows and no more. The profile totals above are whole-table aggregates
    # and stay exact regardless.
    #
    # Names are clipped in SQL, not here: nothing bounds a deck name in the
    # collection, so reading them whole would put the roster's footprint back
    # in the hands of whoever wrote the DB. MAX_KEY_NAME is generous enough
    # that this is not the clip anyone sees — it is the aggregation key, and
    # two roots would have to share that many characters to be merged.
    did_conf = {}
    deck_names = {}
    deck_scan = con.execute(
        "SELECT id, substr(name, 1, ?), common FROM decks ORDER BY id LIMIT ?",
        (MAX_KEY_NAME, MAX_DECK_SCAN + 1),
    ).fetchall()
    decks_truncated = len(deck_scan) > MAX_DECK_SCAN
    for did, name, common in deck_scan[:MAX_DECK_SCAN]:
        did_conf[int(did)] = deck_conf_id(common)
        deck_names[int(did)] = name
    del deck_scan

    # Same, per deck: revlog carries cid, not did, so resolve through cards.
    # A deleted card's reviews still count toward the profile total but fall
    # out of every deck row — acceptable drift for a status widget.
    deck_studied: dict[int, list[int]] = {}
    for did, count, secs in con.execute(
        """SELECT c.did, count(*), coalesce(sum(r.time)/1000, 0)
           FROM revlog r JOIN cards c ON c.id = r.cid
           WHERE r.id >= ? GROUP BY c.did""",
        (today_start_ms,),
    ):
        if int(did) in deck_names:
            deck_studied[int(did)] = [int(count), int(secs or 0)]

    # Roll decks up to their tree root so the panel shows one row per
    # top-level deck instead of one per nested list — a GRE\x1fList 30 tree
    # is one study unit, not thirty rows. This is the aggregation key, so it
    # is deliberately NOT clipped: two decks sharing a long prefix must stay
    # two rows. Clipping happens at output time, in clip_name.
    def root_name(name: str) -> str:
        return str(name or "").split("\x1f")[0]

    # Display form of a root name. Deck names are user-supplied text that
    # ends up in a document the shell buffers whole, so the emitted string is
    # bounded even though the key above is not — by length and by what it
    # actually costs once escaped, which for CJK or emoji is several times
    # its length. Converges geometrically; the panel elides at ~30 chars
    # anyway, so nothing legible is lost.
    def clip_name(root: str) -> str:
        name = root[:MAX_DECK_NAME]
        while len(name) > 1:
            cost = len(json.dumps(name).encode())
            if cost <= MAX_DECK_NAME_BYTES:
                break
            name = name[:max(1, int(len(name) * MAX_DECK_NAME_BYTES / cost))]
        return name if name == root else name + "…"

    # These GROUP BY scans are streamed rather than fetched whole: the result
    # sets are as wide as the collection's deck table, and only the roster's
    # share is worth holding in memory. Per-preset totals aggregate every
    # row, roster or not, so the cap and the backlog it is compared against
    # are always measured over the same population.
    new_introduced = {}
    for did, count in con.execute(
        """SELECT did, count(*) FROM cards
           WHERE queue > 0 AND type IN (1,2)
           GROUP BY did"""
    ):
        conf_id = did_conf.get(int(did), 1)
        new_introduced[conf_id] = new_introduced.get(conf_id, 0) + count

    # Raw new backlog, once: per deck for the roster's row counts, and summed
    # per preset for the sibling split. Summing here rather than in an inner
    # loop keeps the deck pass linear in the number of decks.
    deck_new_backlog = {}
    conf_sibling_new = {}
    for did, count in con.execute(
        "SELECT did, count(*) FROM cards WHERE queue=0 AND type=0 AND odid=0 GROUP BY did"
    ):
        did = int(did)
        conf_id = did_conf.get(did, 1)
        conf_sibling_new[conf_id] = conf_sibling_new.get(conf_id, 0) + count
        if did in deck_names:
            deck_new_backlog[did] = count

    # Today's learn/review counts for every deck in one pass. One query per
    # deck meant the collection's deck count decided how many scans we ran.
    deck_today = {}
    for did, learn_c, review_c in con.execute(
        """SELECT did,
                 sum(CASE WHEN queue IN (1,3) AND odid=0 AND due <= ? THEN 1 ELSE 0 END),
                 sum(CASE WHEN queue=2 AND odid=0 AND due <= ? THEN 1 ELSE 0 END)
           FROM cards GROUP BY did""",
        (int(today_start_sec + day_len), day_cutoff_end),
    ):
        if int(did) in deck_names:
            deck_today[int(did)] = (int(learn_c or 0), int(review_c or 0))

    conf_remaining = {}
    for conf_id, cap in conf_caps.items():
        if cap > 0:
            conf_remaining[conf_id] = max(0, cap - new_introduced.get(conf_id, 0))

    deck_rows = {}
    for did, name in deck_names.items():
        name = root_name(name)
        learn_c, review_c = deck_today.get(did, (0, 0))
        new_c = deck_new_backlog.get(did, 0)
        conf_id = did_conf.get(did, 1)
        cap = conf_caps.get(conf_id, 0)
        if new_c == 0:
            new_remaining = 0
        elif cap <= 0:
            new_remaining = new_c
        else:
            # Split the preset's remaining capacity across its decks in
            # proportion to each deck's raw new backlog — a fair stand-in
            # for Anki's position-ordered draw.
            sibling_new = conf_sibling_new.get(conf_id, new_c)
            capacity = conf_remaining.get(conf_id, cap)
            if sibling_new <= capacity:
                new_remaining = new_c
            else:
                new_remaining = min(new_c, max(0, round(capacity * new_c / max(1, sibling_new))))
        row = deck_rows.setdefault(name, {
            "name": name, "depth": 0, "new": 0, "learn": 0, "review": 0,
            "due": 0, "newRemaining": 0, "studiedToday": 0, "timeTodaySec": 0,
        })
        row["new"] += new_c
        row["learn"] += learn_c
        row["review"] += review_c
        row["newRemaining"] += new_remaining
        row["due"] += new_remaining + learn_c + review_c
        studied_c, time_c = deck_studied.get(did, [0, 0])
        row["studiedToday"] += studied_c
        row["timeTodaySec"] += time_c

    # --- forecast: review cards due in the coming N days ------------------
    horizon = forecast_days + 1  # include today at index 0
    forecast = [0] * horizon
    rows = con.execute(
        """SELECT due - ?, count(*) FROM cards
           WHERE queue=2 AND odid=0 AND due > ? AND due <= ?
           GROUP BY due""",
        (today_number, today_number, today_number + forecast_days),
    ).fetchall()
    for offset, count in rows:
        if 0 < int(offset) <= forecast_days:
            forecast[int(offset)] = int(count)
    forecast[0] = review_today  # today: what's actually queued now


    days = []
    base = time.strftime("%Y-%m-%d", time.localtime(today_start_sec))
    for i in range(horizon):
        ts = today_start_sec + i * day_len
        days.append({"day": time.strftime("%Y-%m-%d", time.localtime(ts)), "count": forecast[i]})

    # --- 30-day mature retention ------------------------------------------
    mature = con.execute(
        """SELECT sum(CASE WHEN ease > 1 THEN 1 ELSE 0 END), count(*)
           FROM revlog WHERE id >= ? AND lastIvl >= 21""",
        (today_start_ms - 30 * day_len * 1000,),
    ).fetchone()
    retention = (mature[0] / mature[1]) if mature and mature[1] else -1.0

    # Per-deck 30-day mature retention, rolled up to the tree root.
    deck_retention: dict[str, list[int]] = {}
    for did, correct, total in con.execute(
        """SELECT c.did,
                  sum(CASE WHEN r.ease > 1 THEN 1 ELSE 0 END), count(*)
           FROM revlog r JOIN cards c ON c.id = r.cid
           WHERE r.id >= ? AND r.lastIvl >= 21 GROUP BY c.did""",
        (today_start_ms - 30 * day_len * 1000,),
    ):
        if int(did) not in deck_names:
            continue
        name = root_name(deck_names[int(did)])
        acc = deck_retention.setdefault(name, [0, 0])
        acc[0] += int(correct or 0)
        acc[1] += int(total)

    new_remaining_total = sum(d["newRemaining"] for d in deck_rows.values())
    caps = [c for c in conf_caps.values() if c > 0]

    for name, row in deck_rows.items():
        correct, total = deck_retention.get(name, [0, 0])
        row["retention"] = round(correct / total, 4) if total else -1

    ranked = sorted(
        deck_rows.values(),
        key=lambda d: (-d["due"], d["name"].lower()),
    )
    # Clip only what we emit, and only the rows that survive the cut: the
    # rows above were keyed and sorted on the full root name. Clipping can
    # collide — decks sharing a long prefix land on the same label — and the
    # panel identifies a scoped deck by this string, so collisions are
    # numbered rather than left ambiguous.
    shown = ranked[:max_decks]
    labels: dict[str, int] = {}
    for row in shown:
        label = clip_name(row["name"])
        seen = labels.get(label, 0) + 1
        labels[label] = seen
        row["name"] = label if seen == 1 else "%s (%d)" % (label, seen)

    return {
        "profile": "",
        "new": new_today,
        "learn": learn_today,
        "review": review_today,
        "due": new_remaining_total + learn_today + review_today,
        "newRemaining": new_remaining_total,
        "studiedToday": studied_today,
        "timeTodaySec": time_today_sec,
        "todayLimit": min(caps) if caps else 0,
        "retention": round(retention, 4) if retention >= 0 else -1,
        "forecast": days,
        # Heaviest decks first, then cut to the row budget: the panel shows a
        # short list and the shell buffers whatever we print, so the tail of a
        # thousand-deck collection is cost with no reader.
        "decks": shown,
        # -1, not a lower bound: when the deck table itself outran the scan
        # budget, len(ranked) counts only what we looked at, and the panel
        # would present that as the collection total. Unknown is the honest
        # answer, and the panel drops the "OF n" when it sees it.
        "deckCount": -1 if decks_truncated else len(ranked),
        "decksTruncated": decks_truncated or len(ranked) > max_decks,
    }


def emit(report: dict) -> None:
    """Print the report, holding it under the byte ceiling no matter what.

    The panel reads our stdout into a single buffer, so the last word on how
    large that buffer can get has to be ours. Row caps and name clipping keep
    a normal report a few KB. Past that: the error string is clipped, deck
    rows are shed, and if some other field is still oversized the whole
    record is replaced by a minimal one — the ceiling is never merely
    advisory.
    """
    err = report.get("error")
    if isinstance(err, str) and len(err) > MAX_ERROR_CHARS:
        report["error"] = err[:MAX_ERROR_CHARS - 1] + "…"
    text = json.dumps(report)
    while len(text.encode()) > MAX_OUTPUT_BYTES and report.get("decks"):
        # Trim to what the overage says will fit rather than halving: with
        # CJK or emoji deck names the budget binds well before the row cap,
        # and halving throws away rows that would have fit. The 0.95 leaves
        # room for the fields that are not deck rows; max(1, ...) with the
        # len-1 ceiling guarantees the loop makes progress.
        rows = report["decks"]
        ratio = MAX_OUTPUT_BYTES / len(text.encode())
        keep = min(len(rows) - 1, max(0, int(len(rows) * ratio * 0.95)))
        report["decks"] = rows[:keep]
        report["decksTruncated"] = True
        text = json.dumps(report)
    if len(text.encode()) > MAX_OUTPUT_BYTES:
        text = json.dumps({
            "running": bool(report.get("running")),
            "profile": "", "collection": "",
            "error": "Report exceeded the output budget",
        })
    print(text)


def main() -> int:
    parser = argparse.ArgumentParser(description="Anki collection status as JSON")
    parser.add_argument("--profile", default=None, help="Anki profile name (default: last used)")
    parser.add_argument("--forecast-days", type=int, default=7)
    parser.add_argument("--collection", default=None, help="Path to collection.anki2 (skips profile lookup)")
    parser.add_argument("--max-decks", type=int, default=DEFAULT_DECK_ROWS,
                        help=f"Deck rows to report, heaviest first (max {MAX_DECK_ROWS})")
    args = parser.parse_args()

    report = {"running": anki_running(), "profile": "", "collection": "", "error": ""}

    try:
        if args.collection:
            collection = Path(args.collection).expanduser()
            report["profile"] = collection.parent.name
        else:
            profile = pick_profile(args.profile)
            if not profile:
                report["error"] = "No Anki profile with a collection found under " + str(ANKI_BASE)
                emit(report)
                return 0
            report["profile"] = profile
            collection = ANKI_BASE / profile / "collection.anki2"
        if not collection.exists():
            report["error"] = "Collection not found: " + str(collection)
            emit(report)
            return 0
        report["collection"] = str(collection)
        data = build_report(
            collection,
            max(1, min(30, args.forecast_days)),
            max(1, min(MAX_DECK_ROWS, args.max_decks)),
        )
        data.pop("profile", None)
        report.update(data)
    except Exception as exc:  # surface as JSON, never crash the panel
        report["error"] = f"{type(exc).__name__}: {exc}"

    emit(report)
    return 0


if __name__ == "__main__":
    sys.exit(main())
